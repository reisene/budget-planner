// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?   @unique
  priceId              String?
  status               String    @default("free")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

model AccountSettings {
  userId    String   @id
  currency  String   @default("USD") @db.VarChar(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id                String             @id @default(cuid())
  userId            String
  name              String             @db.VarChar(60)
  type              TransactionType
  color             String             @default("#72ddb0") @db.VarChar(7)
  isArchived        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  transactions      Transaction[]
  recurringPayments RecurringPayment[]

  @@unique([userId, name, type])
  @@index([userId, type, isArchived])
}

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  categoryId           String?
  recurringPaymentId   String?
  recurrenceOccurrence DateTime?         @db.Date
  description          String            @db.VarChar(120)
  amount               Decimal           @db.Decimal(19, 4)
  type                 TransactionType
  occurredAt           DateTime          @db.Date
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  category             Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringPayment     RecurringPayment? @relation(fields: [recurringPaymentId], references: [id], onDelete: SetNull)

  @@unique([recurringPaymentId, recurrenceOccurrence])
  @@index([userId, occurredAt])
  @@index([userId, type, occurredAt])
  @@index([categoryId])
}

model RecurringPayment {
  id             String          @id @default(cuid())
  userId         String
  categoryId     String?
  description    String          @db.VarChar(120)
  amount         Decimal         @db.Decimal(19, 4)
  type           TransactionType @default(EXPENSE)
  intervalCount  Int             @default(1)
  intervalUnit   RecurrenceUnit
  startDate      DateTime        @db.Date
  nextOccurrence DateTime        @db.Date
  endDate        DateTime?       @db.Date
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   Transaction[]

  @@index([userId, isActive, nextOccurrence])
  @@index([categoryId])
}

model CurrencyConversion {
  id           String   @id @default(cuid())
  userId       String
  fromCurrency String   @db.VarChar(3)
  toCurrency   String   @db.VarChar(3)
  rate         Decimal  @db.Decimal(20, 10)
  source       String   @db.VarChar(80)
  rateDate     DateTime @db.Date
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}
